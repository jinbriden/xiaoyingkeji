# 复制为 .env 后按需修改。以下均为本地演示用的示例值，不是真实凭据。
DB_USERNAME=studio
DB_PASSWORD=studio_dev_password
MYSQL_ROOT_PASSWORD=studio_dev_root_password

FRONTEND_PORT=3000
BACKEND_PORT=8080

# 同时执行的任务数，调成 1 更容易观察排队
TASK_WORKER_THREADS=2

# 各阶段模拟耗时（毫秒）
SIM_ASSET_CHECK_DELAY_MS=2000
SIM_GENERATE_DELAY_MS=6000
SIM_RESULT_DELAY_MS=2000

# 启动时指定失败阶段：ASSET_CHECK / GENERATE / RESULT，留空表示不失败
SIM_FAIL_STAGE=

# 是否开放 /api/dev/simulation，线上环境设为 false
DEV_API_ENABLED=true
